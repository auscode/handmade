# ============================================================
#  Build Output
# ============================================================
# Compiled executables and libraries
*.exe
*.dll
*.lib
*.pdb       # Program database (debug symbols)
*.ilk       # Incremental linker file
*.obj       # Compiled object files
*.res       # Compiled resource file

# ============================================================
#  Visual Studio Build Folders
# ============================================================
# Intermediate / output directories generated by MSBuild
x64/
x86/
Debug/
Release/

# The nested "handmade/" build folder Visual Studio created
handmade/x64/
handmade/x86/

# ============================================================
#  Visual Studio Metadata & Cache
# ============================================================
*.tlog          # MSBuild tracking logs
*.log           # Build logs
*.recipe        # Build recipe files
*.lastbuildstate

# IntelliSense / browse databases
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb
ipch/

# The entire hidden .vs/ folder (local settings, Copilot index, breakpoints, etc.)
.vs/

# ============================================================
#  User-Specific Files (machine-local settings, do NOT share)
# ============================================================
*.vcxproj.user  # Per-user project settings (debugger paths, env vars)

# ============================================================
#  Misc
# ============================================================
*.dt.d.json
*.dt.module.json
*.dt.module.json.command

